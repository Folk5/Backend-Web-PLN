generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  password_hash String
  name          String
  unit          String?  @default("-")
  status        String   @default("Offline")
  created_at    DateTime @default(now())

  @@map("users")
}

model Category {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  value      String     @unique
  type       String
  created_at DateTime   @default(now())
  materials  Material[]
  tools      Tool[]

  @@map("categories")
}

model Material {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  code            String?
  bgGradient      String?
  description     String?
  image           String?
  created_at      DateTime          @default(now())
  updated_at      DateTime?         @db.Timestamptz(6)
  categories      Category[]
  assets          MaterialAsset[]
  moduleMaterials ModuleMaterial[]

  @@map("materials")
}

model MaterialAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  material_id String   @db.Uuid
  name        String?
  file        String?
  material    Material @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@map("material_assets")
}

model Tool {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  bgGradient  String?
  description String?
  standard    String?
  status      String?
  image       String?
  file3d      String?
  category_id String?      @db.Uuid
  created_at  DateTime     @default(now())
  updated_at  DateTime?    @db.Timestamptz(6)
  category    Category?    @relation(fields: [category_id], references: [id], onDelete: SetNull)
  moduleTools ModuleTool[]

  @@map("tools")
}

model Module {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String?
  image          String?
  status          String           @default("Draft")
  construction_id String?          @db.Uuid
  created_at      DateTime         @default(now())
  updated_at      DateTime?        @db.Timestamptz(6)
  construction    Construction?    @relation(fields: [construction_id], references: [id], onDelete: SetNull)
  materials      ModuleMaterial[]
  tools          ModuleTool[]
  assets         ModuleAsset[]
  meshConfigs    MeshConfig[]

  @@map("modules")
}

model ModuleMaterial {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id   String                 @db.Uuid
  material_id String                 @db.Uuid
  quantity    Int                    @default(1)
  module      Module                 @relation(fields: [module_id], references: [id], onDelete: Cascade)
  material    Material               @relation(fields: [material_id], references: [id], onDelete: Cascade)
  meshes      ModuleMaterialMesh[]

  @@unique([module_id, material_id])
  @@map("module_materials")
}

model ModuleMaterialMesh {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_material_id String         @db.Uuid
  mesh_name          String
  module_material    ModuleMaterial @relation(fields: [module_material_id], references: [id], onDelete: Cascade)

  @@map("module_material_meshes")
}

model ModuleTool {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id String @db.Uuid
  tool_id   String @db.Uuid
  mesh_name String?
  module    Module @relation(fields: [module_id], references: [id], onDelete: Cascade)
  tool      Tool   @relation(fields: [tool_id], references: [id], onDelete: Cascade)

  @@unique([module_id, tool_id])
  @@map("module_tools")
}

model MeshConfig {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id          String  @db.Uuid
  mesh_original_name String
  mesh_display_name  String?
  is_visible         Boolean @default(true)
  module             Module  @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([module_id, mesh_original_name])
  @@map("mesh_config")
}

model ModuleAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id   String   @db.Uuid
  name        String
  file        String
  cam_pos_x   Float?
  cam_pos_y   Float?
  cam_pos_z   Float?
  target_x    Float?
  target_y    Float?
  target_z    Float?
  animation   String   @default("none")
  module      Module   @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@map("module_assets")
}

model Construction {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String         @unique
  level       Int            // 1 = root (Distribusi), 2 = sub-kategori (JTM), 3 = detail (SUTM)
  module_type String         @default("konstruksi") // 'konstruksi' | 'material' | 'peralatan'
  description String?
  image       String?
  parent_id   String?        @db.Uuid
  parent      Construction?  @relation("ConstructionChildren", fields: [parent_id], references: [id], onDelete: Cascade)
  children    Construction[] @relation("ConstructionChildren")
  modules     Module[]
  created_at  DateTime       @default(now())
  updated_at  DateTime?      @db.Timestamptz(6)

  @@map("constructions")
}

model Quiz {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  code        String           @unique
  created_at  DateTime         @default(now())
  questions   Question[]
  submissions QuizSubmission[]

  @@map("quizzes")
}

model Question {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id  String           @db.Uuid
  quiz     Quiz             @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  type     String           // "PG", "CHECKBOX", "ESSAY"
  text     String
  options  QuestionOption[]

  @@map("questions")
}

model QuestionOption {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question_id String   @db.Uuid
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  text        String
  is_correct  Boolean  @default(false)

  @@map("question_options")
}

model QuizSubmission {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quiz_id          String   @db.Uuid
  quiz             Quiz     @relation(fields: [quiz_id], references: [id], onDelete: Cascade)
  participant_name String
  score            Float
  created_at       DateTime @default(now())

  @@map("quiz_submissions")
}

model Listrikpedia {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  abbr        String
  name        String
  description String?
  type        String    @default("singkatan") // "singkatan" | "istilah"
  created_at  DateTime  @default(now())
  updated_at  DateTime? @db.Timestamptz(6)

  @@map("listrikpedia")
}
