# Supabase Configuration
# Masukkan nilai asli di file .env (jangan upload ke NAS)
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Server Configuration
PORT=4000

# JWT — wajib diisi, tidak ada nilai default
JWT_SECRET=ganti_dengan_string_acak_yang_panjang_dan_aman

# CORS — pisahkan beberapa origin dengan koma (tanpa spasi)
# Contoh production: https://lms.pln.co.id,https://admin.pln.co.id
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.137.1:3000
